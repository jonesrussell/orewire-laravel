[Unit]
Description=Orewire Horizon
After=network.target
ConditionPathExists=/home/deployer/orewire-laravel/current

[Service]
Type=simple
WorkingDirectory=/home/deployer/orewire-laravel/current
ExecStart=/usr/bin/php artisan horizon
Restart=always
RestartSec=3

# Horizon needs time to drain workers on SIGTERM
TimeoutStopSec=90
KillMode=mixed

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
