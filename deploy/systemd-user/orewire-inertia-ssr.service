[Unit]
Description=Orewire Inertia SSR server
After=network.target
ConditionPathExists=/home/deployer/orewire-laravel/current

[Service]
Type=simple
WorkingDirectory=/home/deployer/orewire-laravel/current
ExecStart=/bin/bash -lc 'source ~/.nvm/nvm.sh 2>/dev/null; exec /usr/bin/php artisan inertia:start-ssr'
Restart=always
RestartSec=3

TimeoutStopSec=30
KillMode=mixed

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
