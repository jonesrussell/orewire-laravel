# New native stack (Deployer + Caddy). Copy to server (e.g. /etc/caddy/Caddyfile).
# Root must be deployer's current release. Adjust php_fastcgi if your PHP-FPM socket differs.
orewire.ca {
    root * /home/deployer/orewire-laravel/current/public
    encode gzip
    # Serve Vite build assets statically before PHP (Caddy runs php_fastcgi before file_server by default)
    handle /build/* {
        file_server
    }
    handle {
        php_fastcgi unix//run/php/php8.4-fpm.sock
        file_server
    }
}
